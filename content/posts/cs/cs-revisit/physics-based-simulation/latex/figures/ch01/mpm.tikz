\begin{tikzpicture}[x=1.65cm, y=1.65cm]
  \definecolor{mpmgrid}{RGB}{78,171,209}
  \definecolor{mpmparticle}{RGB}{129,214,83}

  % Uniform background Eulerian grid
  \foreach \i in {0,1,2,3} {
    \draw[mpmgrid, line width=1.8pt] (\i,-0.22) -- (\i,3.30);
    \draw[mpmgrid, line width=1.8pt] (-0.22,\i) -- (3.30,\i);
  }

  % Lagrangian sampling points (particles)
  \foreach \px/\py in {
    0.312/2.798, 0.863/2.799, 1.417/2.799, 1.931/2.798, 2.451/2.799,
    0.312/2.267, 0.778/2.371, 1.244/2.434, 1.659/2.434, 2.089/2.267,
    0.312/1.735, 0.778/1.751, 1.177/1.980, 1.771/1.875,
    0.311/1.207, 0.863/1.388, 1.417/1.472,
    0.998/1.005, 1.423/1.067,
    0.311/0.714, 0.695/0.622, 1.176/0.622, 1.686/0.798, 2.089/0.537,
    0.311/0.222, 0.778/0.211, 1.245/0.223, 1.686/0.222, 2.089/0.222, 2.451/0.222
  } {
    \fill[mpmparticle] (\px,\py) circle (3.8pt);
  }

  % Active grid nodes recording solid density
  \foreach \gx/\gy in {
    0/0, 1/0, 2/0, 3/0,
    0/1, 1/1, 2/1,
    0/2, 1/2, 2/2,
    0/3, 1/3, 2/3, 3/3
  } {
    \draw[black, line width=1.5pt] (\gx,\gy) circle (4.6pt);
  }
\end{tikzpicture}
