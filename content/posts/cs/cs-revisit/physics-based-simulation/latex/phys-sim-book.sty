\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{phys-sim-book}[2026/11/22 Minimalist academic style for Physics-Based Simulation]

% -----------------------------------------------------------------------------
% Page layout & typography
% -----------------------------------------------------------------------------
\RequirePackage[
  a4paper,
  top=2.5cm,
  bottom=2.5cm,
  left=2.8cm,
  right=2.8cm,
  headheight=24pt,
  headsep=16pt,
  footskip=24pt
]{geometry}

\RequirePackage{microtype}
\RequirePackage{setspace}
\setstretch{1.18}

\RequirePackage{enumitem}
\setlist{itemsep=0.2em, topsep=0.4em, parsep=0pt}

% -----------------------------------------------------------------------------
% Strictly monochrome academic palette (pure black, white, and neutral gray)
% -----------------------------------------------------------------------------
\RequirePackage[dvipsnames,svgnames,table]{xcolor}

\definecolor{AcademicMuted}{HTML}{555555}
\definecolor{AcademicRule}{HTML}{CCCCCC}

% -----------------------------------------------------------------------------
% Mathematics, figures, tables, and diagrams
% -----------------------------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathtools}
\RequirePackage{bm}
\RequirePackage{graphicx}
\RequirePackage[font=small,labelfont=bf]{caption}
\RequirePackage{subcaption}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{float}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, calc, positioning, shapes.geometric}

\graphicspath{{figures/}}
\numberwithin{equation}{chapter}

% -----------------------------------------------------------------------------
% Chapter & section styling (classic academic monograph)
% -----------------------------------------------------------------------------
\ctexset{
  part = {
    name = {第,部分},
    number = \chinese{part},
    nameformat = \large\rmfamily\color{AcademicMuted},
    titleformat = \Huge\bfseries\rmfamily,
  },
  chapter = {
    name = {第,章},
    number = \arabic{chapter},
    format = \raggedright\huge\bfseries,
    nameformat = \normalsize\mdseries\color{AcademicMuted},
    aftername = \par\vspace{0.25em},
    aftertitle = \par\vspace{0.45em}{\color{AcademicRule}\hrule height 0.5pt},
    beforeskip = 1.0em,
    afterskip = 1.6em,
  },
  section = {
    format = \Large\bfseries,
    beforeskip = 1.4em plus 0.3em minus 0.2em,
    afterskip = 0.6em plus 0.1em,
  },
  subsection = {
    format = \large\bfseries,
    beforeskip = 1.1em plus 0.2em minus 0.1em,
    afterskip = 0.45em plus 0.1em,
  },
  subsubsection = {
    format = \normalsize\bfseries,
  },
}

% -----------------------------------------------------------------------------
% Headers & footers
% -----------------------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{AcademicMuted}\nouppercase{\leftmark}}
\fancyhead[R]{\small\color{AcademicMuted}\nouppercase{\rightmark}}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{AcademicRule}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\small\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

% -----------------------------------------------------------------------------
% Bibliography (biblatex + biber)
% -----------------------------------------------------------------------------
\RequirePackage[
  backend=biber,
  style=numeric-comp,
  sorting=none,
  doi=true,
  url=true,
  isbn=false
]{biblatex}

% -----------------------------------------------------------------------------
% Code listings (clean academic top/bottom rules)
% -----------------------------------------------------------------------------
\RequirePackage{listings}

\lstdefinestyle{physsimcode}{
  backgroundcolor=\color{white},
  basicstyle=\ttfamily\small,
  commentstyle=\itshape\color{AcademicMuted},
  keywordstyle=\bfseries,
  stringstyle=\color{AcademicMuted},
  numberstyle=\scriptsize\color{AcademicMuted},
  numbers=left,
  numbersep=10pt,
  stepnumber=1,
  frame=tb,
  rulecolor=\color{AcademicRule},
  framerule=0.5pt,
  xleftmargin=1.6em,
  framexleftmargin=1.2em,
  breaklines=true,
  breakatwhitespace=true,
  showstringspaces=false,
  tabsize=4,
  aboveskip=0.9em,
  belowskip=0.9em,
  captionpos=t
}
\lstset{style=physsimcode}
\renewcommand{\lstlistingname}{代码}

% -----------------------------------------------------------------------------
% Algorithms (algorithm2e)
% -----------------------------------------------------------------------------
\RequirePackage[ruled,vlined,linesnumbered,algosection]{algorithm2e}
\SetAlgorithmName{算法}{算法}{算法目录}
\SetKwInput{KwIn}{Input}
\SetKwInput{KwOut}{Output}
\SetAlCapFnt{\bfseries}
\SetAlCapNameFnt{\normalfont}
\SetCommentSty{myalgcomment}
\newcommand{\myalgcomment}[1]{\footnotesize\ttfamily\color{AcademicMuted}#1}

% Match original book's per-section numbering (mdbook-numeq / mdbook-numthm)
\numberwithin{equation}{section}
\numberwithin{figure}{section}
\numberwithin{table}{section}

% -----------------------------------------------------------------------------
% Hyperlinks & clever cross-references (load after most packages)
% -----------------------------------------------------------------------------
\RequirePackage[
  colorlinks=true,
  linkcolor=black,
  citecolor=black,
  urlcolor=black,
  bookmarksnumbered=true,
  bookmarksopen=true,
  pdfencoding=auto
]{hyperref}

\RequirePackage[nameinlink,noabbrev]{cleveref}

% -----------------------------------------------------------------------------
% Monochrome textbook environments (borderless light-gray callout blocks)
% -----------------------------------------------------------------------------
\newtheoremstyle{academicplain}
  {0pt}         % Space above (handled by tcolorbox)
  {0pt}         % Space below (handled by tcolorbox)
  {\normalfont} % Body font (upright for clean CJK + math)
  {}            % Indent amount
  {\bfseries}   % Theorem head font
  {.}           % Punctuation after theorem head
  {0.6em}       % Space after theorem head
  {\thmname{#1}\thmnumber{ #2}\thmnote{ \bfseries(#3)}}

\theoremstyle{academicplain}
\newtheorem{definition}{定义}[section]
\newtheorem{theorem}{定理}[section]
\newtheorem{lemma}{引理}[section]
\newtheorem{proposition}{命题}[section]
\newtheorem{corollary}{推论}[section]
\newtheorem{method}{方法}[section]
\newtheorem{example}{例}[section]
\newtheorem{remark}{注记}[section]

% -----------------------------------------------------------------------------
% Minimalist editorial note & callout environments (tcolorbox)
% -----------------------------------------------------------------------------
\RequirePackage[skins,breakable]{tcolorbox}

\tcbset{
  academicblock/.style={
    enhanced,
    breakable,
    boxrule=0pt,
    frame hidden,
    colback=black!3,
    left=10pt,
    right=10pt,
    top=7pt,
    bottom=7pt,
    before skip=10pt,
    after skip=10pt,
    sharp corners
  },
  academicnote/.style={
    enhanced,
    breakable,
    boxrule=0pt,
    frame hidden,
    borderline west={1.2pt}{0pt}{black!35},
    colback=white,
    coltitle=black,
    fonttitle=\small\bfseries,
    fontupper=\small,
    left=10pt,
    right=4pt,
    top=3pt,
    bottom=3pt,
    before skip=9pt,
    after skip=9pt,
    sharp corners,
    attach title to upper={\quad}
  }
}

\tcolorboxenvironment{definition}{academicblock}
\tcolorboxenvironment{theorem}{academicblock}
\tcolorboxenvironment{lemma}{academicblock}
\tcolorboxenvironment{proposition}{academicblock}
\tcolorboxenvironment{corollary}{academicblock}
\tcolorboxenvironment{method}{academicblock}
\tcolorboxenvironment{example}{academicblock}
\tcolorboxenvironment{remark}{academicblock}

\newtcolorbox{studynote}[1][学习笔记]{
  academicnote,
  title={#1}
}

\newtcolorbox{transnote}[1][译注]{
  academicnote,
  title={#1}
}

\newtcolorbox{warningbox}[1][注意]{
  academicnote,
  borderline west={1.5pt}{0pt}{black!65},
  title={#1}
}

\newtcolorbox{summarybox}[1][本章小结]{
  enhanced,
  breakable,
  boxrule=0pt,
  frame hidden,
  borderline north={0.6pt}{0pt}{black!45},
  borderline south={0.6pt}{0pt}{black!45},
  colback=white,
  coltitle=black,
  fonttitle=\bfseries,
  left=4pt,
  right=4pt,
  top=8pt,
  bottom=8pt,
  before skip=12pt,
  after skip=12pt,
  sharp corners,
  attach title to upper={\par\vspace{0.35em}},
  title={#1}
}

% -----------------------------------------------------------------------------
% Cleveref Chinese labels
% -----------------------------------------------------------------------------
\crefname{chapter}{第}{第}
\Crefname{chapter}{第}{第}
\crefformat{chapter}{#2第~#1~章#3}
\Crefformat{chapter}{#2第~#1~章#3}
\crefname{section}{第}{第}
\crefformat{section}{#2第~#1~节#3}
\Crefformat{section}{#2第~#1~节#3}
\crefname{equation}{式}{式}
\crefformat{equation}{#2式~(#1)#3}
\Crefformat{equation}{#2式~(#1)#3}
\crefname{figure}{图}{图}
\crefname{table}{表}{表}
\crefname{algocf}{算法}{算法}
\Crefname{algocf}{算法}{算法}
\crefname{algorithm}{算法}{算法}
\Crefname{algorithm}{算法}{算法}
\crefname{definition}{定义}{定义}
\crefname{theorem}{定理}{定理}
\crefname{lemma}{引理}{引理}
\crefname{proposition}{命题}{命题}
\crefname{corollary}{推论}{推论}
\crefname{method}{方法}{方法}
\crefname{example}{例}{例}
\crefname{remark}{注记}{注记}

% -----------------------------------------------------------------------------
% Bilingual terminology & translation helpers
% -----------------------------------------------------------------------------
% First occurrence of a translated technical term: \term{隐式时间积分}{implicit time integration}
\newcommand{\term}[2]{\textbf{#1}（\textit{#2}）}
% Inline English technical term: \eng{Projected Newton}
\newcommand{\eng}[1]{\textit{#1}}
% Inline TODO marker while studying/translating
\newcommand{\todo}[1]{\textcolor{AcademicMuted}{\small\textbf{[TODO: #1]}}}

\endinput
