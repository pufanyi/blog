{
  "name": "blog",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:data": "tsx --tsconfig tsconfig.scripts.json scripts/build-posts.mts",
    "prebuild": "pnpm generate:data",
    "postbuild": "node scripts/prepare-deployment.mts",
    "prestart": "pnpm generate:data",
    "pretest": "pnpm generate:data",
    "start": "ng serve",
    "build": "ng build",
    "watch": "pnpm generate:data && ng build --watch --configuration development",
    "test": "pnpm test:generated",
    "test:generated": "pnpm test:content && ng test",
    "test:content": "tsx --tsconfig tsconfig.scripts.json --test scripts/lib/*.spec.mts",
    "typecheck:content": "tsc --noEmit -p tsconfig.scripts.json",
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "lint": "ng lint && pnpm lint:content",
    "lint:fix": "ng lint --fix",
    "lint:content": "pnpm lint:mdx && pnpm lint:bib",
    "lint:mdx": "remark 'content/posts/**/*.mdx' --frail --quiet",
    "lint:bib": "node scripts/check-bibtex.mts",
    "format:bib": "node scripts/check-bibtex.mts --write",
    "check": "pnpm check:generated",
    "check:generated": "pnpm biome:check && pnpm typecheck:content && pnpm typecheck:e2e && pnpm lint",
    "preview": "node scripts/serve-preview.mts",
    "preview:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "precheck": "pnpm generate:data",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@formkit/auto-animate": "^0.10.0",
    "@phosphor-icons/web": "^2.1.2",
    "@shikijs/transformers": "^4.4.2",
    "charter-webfont": "^4.1.0",
    "flexsearch": "^0.8.212",
    "marked": "^18.0.9",
    "medium-zoom": "^1.1.0",
    "modern-normalize": "^3.0.1",
    "ngx-extended-pdf-viewer": "^30.0.0",
    "rxjs": "~7.8.2",
    "shiki": "^4.4.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@biomejs/biome": "^2.5.7",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "angular-eslint": "22.1.0",
    "bibtex-tidy": "^1.15.1",
    "eslint": "^10.6.0",
    "image-size": "^2.0.2",
    "jiti": "^2.7.0",
    "js-yaml": "^5.2.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-citation": "^2.3.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "unified": "^11.0.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.1"
  }
}
