{
  "name": "blog",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:data": "tsx --tsconfig tsconfig.scripts.json scripts/build-posts.mts",
    "prebuild": "pnpm generate:data",
    "postbuild": "node scripts/prepare-deployment.mts",
    "pretest": "pnpm generate:data",
    "start": "node scripts/develop.mts serve",
    "build": "ng build",
    "watch": "node scripts/develop.mts build",
    "test": "pnpm test:generated",
    "test:generated": "pnpm test:content && ng test",
    "test:content": "tsx --tsconfig tsconfig.scripts.json --test scripts/lib/*.spec.mts",
    "typecheck:content": "tsc --noEmit -p tsconfig.scripts.json",
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "lint": "pnpm lint:code && pnpm lint:content",
    "lint:fix": "pnpm lint:code --fix",
    "lint:content": "pnpm lint:mdx && pnpm lint:bib",
    "lint:mdx": "remark 'content/posts/**/*.mdx' --frail --quiet",
    "lint:bib": "node scripts/check-bibtex.mts",
    "format:bib": "node scripts/check-bibtex.mts --write",
    "check": "pnpm check:generated",
    "check:generated": "pnpm biome:check && pnpm check:boundaries && pnpm typecheck:app && pnpm typecheck:content && pnpm typecheck:e2e && pnpm lint",
    "preview": "node scripts/serve-preview.mts",
    "preview:cloudflare": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "precheck": "pnpm generate:data",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:app": "ngc --noEmit -p tsconfig.app.json",
    "lint:code": "eslint .",
    "check:boundaries": "node scripts/check-boundaries.mts"
  },
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@formkit/auto-animate": "^0.10.0",
    "@lichess-org/chessground": "10.5.0",
    "@phosphor-icons/web": "^2.1.2",
    "@shikijs/transformers": "^4.5.0",
    "charter-webfont": "^4.1.0",
    "flexsearch": "^0.8.212",
    "marked": "^18.1.1",
    "medium-zoom": "^1.1.0",
    "modern-normalize": "^3.0.1",
    "ngx-extended-pdf-viewer": "^31.0.1",
    "rxjs": "~7.8.2",
    "shiki": "^4.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@biomejs/biome": "^2.6.2",
    "@eslint/js": "^10.0.1",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "angular-eslint": "22.6.0",
    "bibtex-tidy": "^1.15.1",
    "chessops": "0.15.1",
    "eslint": "^10.13.0",
    "image-size": "^2.0.4",
    "jiti": "^2.7.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "mathjax": "4.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-citation": "^2.3.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "unified": "^11.0.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
