{
  "name": "blog",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:data": "node scripts/build-posts.mjs",
    "prebuild": "pnpm generate:data",
    "prestart": "pnpm generate:data",
    "pretest": "pnpm generate:data",
    "start": "ng serve",
    "build": "ng build",
    "watch": "pnpm generate:data && ng build --watch --configuration development",
    "test": "pnpm test:content && ng test",
    "test:content": "node --test scripts/lib/*.spec.mjs",
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "lint": "ng lint && pnpm lint:content",
    "lint:fix": "ng lint --fix",
    "lint:content": "pnpm lint:mdx && pnpm lint:bib",
    "lint:mdx": "remark 'content/posts/**/*.mdx' --frail --quiet",
    "lint:bib": "node scripts/check-bibtex.mjs",
    "format:bib": "node scripts/check-bibtex.mjs --write",
    "check": "pnpm biome:check && pnpm lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@formkit/auto-animate": "^0.10.0",
    "@phosphor-icons/web": "^2.1.2",
    "@shikijs/transformers": "^4.4.2",
    "charter-webfont": "^4.1.0",
    "flexsearch": "^0.8.212",
    "marked": "^18.0.9",
    "medium-zoom": "^1.1.0",
    "modern-normalize": "^3.0.1",
    "rxjs": "~7.8.2",
    "shiki": "^4.4.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@biomejs/biome": "^2.5.7",
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "angular-eslint": "22.1.0",
    "bibtex-tidy": "^1.15.1",
    "eslint": "^10.6.0",
    "js-yaml": "^5.2.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-citation": "^2.3.2",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.10"
  }
}
