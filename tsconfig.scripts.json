{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "scripts/**/*.ts",
    "content/posts/**/scripts/*.post-component.tsx"
  ]
}
