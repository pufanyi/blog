import { execFileSync } from 'node:child_process';
import { mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { collectIconNames } from './lib/icon-subset.mts';

const root = fileURLToPath(new URL('..', import.meta.url));
const upstream = join(root, 'node_modules/@phosphor-icons/web');
const source = readFileSync(join(upstream, 'src/regular/style.css'), 'utf8');
const icons = collectIconNames(root).map((name) => {
  const codepoint = source.match(
    new RegExp(`\\.ph\\.ph-${name}:before\\s*\\{\\s*content: "\\\\([a-f0-9]+)"`),
  )?.[1];
  if (!codepoint) throw new Error(`Unknown Phosphor icon: ${name}`);
  return { name, codepoint };
});
const output = join(root, 'src/styles/icons');
mkdirSync(output, { recursive: true });
execFileSync(
  process.env['PHOSPHOR_SUBSETTER'] ?? 'pyftsubset',
  [
    join(upstream, 'src/regular/Phosphor.woff2'),
    `--unicodes=${icons.map(({ codepoint }) => `U+${codepoint}`).join(',')}`,
    '--flavor=woff2',
    '--no-recalc-timestamp',
    `--output-file=${join(output, 'phosphor.woff2')}`,
  ],
  { stdio: 'inherit' },
);
const license = readFileSync(join(upstream, 'LICENSE'), 'utf8').trim();
const base = source.slice(source.indexOf('.ph {'), source.indexOf('.ph.ph-acorn:before')).trim();
const css = `/* Generated by scripts/subset-icons.mts. */
/*! ${license} */
@font-face {
  font-family: "Phosphor";
  src: url("./phosphor.woff2") format("woff2");
  font-weight: normal;
  font-style: normal;
  font-display: block;
}
${base}
:root {
${icons.map(({ name, codepoint }) => `  --icon-${name}: "\\${codepoint}";`).join('\n')}
}
${icons.map(({ name }) => `.ph.ph-${name}::before { content: var(--icon-${name}); }`).join('\n')}
`;
writeFileSync(join(output, 'phosphor.css'), css);
console.log(
  `Generated ${icons.length} Phosphor icons. Format with pnpm exec biome format --write src/styles/icons/phosphor.css.`,
);
