{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "*.{ts,mts,json,jsonc}",
      "scripts/**/*.mts",
      "docs/**/*.json",
      "src/**/*.{ts,css}",
      "content/posts/**/scripts/**/*.{ts,mts,tsx}",
      "content/posts/**/*.css",
      "content/shared/**/*.{ts,tsx,css}",
      "!!src/app/data"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noImportantStyles": "off",
        "noUselessStringRaw": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noComponentHookFactories": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/styles/icons/phosphor.css"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["content/shared/chess/styles.css"],
      "linter": {
        "rules": {
          "correctness": {
            "noInvalidDirectionInLinearGradient": "off",
            "noUnknownTypeSelector": "off"
          }
        }
      }
    },
    {
      "includes": ["content/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noAriaHiddenOnFocusable": "off",
            "noNoninteractiveTabindex": "off",
            "useAriaPropsSupportedByRole": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ]
}
