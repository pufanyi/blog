{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "*.{ts,mts,json,jsonc}",
      "scripts/**/*.mts",
      "docs/**/*.json",
      "e2e/**/*.ts",
      "src/**/*.{ts,css}",
      "content/posts/**/scripts/**/*.{ts,mts,tsx}",
      "content/posts/**/*.css",
      "!!src/app/data/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": false
  }
}
